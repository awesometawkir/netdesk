#!/usr/bin/env bash
# Guided, logged serial-console session.

set -u

printf 'Serial session setup\n'
printf '  1) Configuration only — connect without creating a log\n'
printf '  2) Configuration + clean log — save device output (PuTTY-style)\n'
read -r -p 'Choose session type [1-2] (default 1): ' session_type
session_type=${session_type:-1}

case "$session_type" in
    1) session_args=() ;;
    2) session_args=(--log) ;;
    *)
        printf 'That is not a valid session type.\n' >&2
        exit 2
        ;;
esac

printf '\nConnection settings\n'
printf '  1) Standard console — 9600 baud (8N1, no flow control)\n'
printf '  2) Fast console     — 115200 baud (8N1, no flow control)\n'
printf '  3) Custom baud rate\n'

read -r -p 'Choose a session [1-3] (default 1): ' session_choice
session_choice=${session_choice:-1}

case "$session_choice" in
    1) speed=9600 ;;
    2) speed=115200 ;;
    3)
        read -r -p 'Enter baud rate (for example, 57600): ' speed
        if [[ ! $speed =~ ^[0-9]+$ ]] || ((speed < 300 || speed > 4000000)); then
            printf 'That is not a valid baud rate.\n' >&2
            exit 2
        fi
        ;;
    *)
        printf 'That is not a valid session choice.\n' >&2
        exit 2
        ;;
esac

exec "$(dirname -- "$(readlink -f -- "$0")")/serialconnect" "${session_args[@]}" "$speed"
